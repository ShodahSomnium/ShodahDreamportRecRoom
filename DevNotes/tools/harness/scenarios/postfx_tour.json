    {"call": "SomniumSpace.Worlds.SomniumRecRoom.RrPostFx.TestOn"},
    {"shot": "pfx_dorm_after", "pos": [0.3, 1.6, 1.9], "look": [0.3, 1.3, -2.9], "frame": "room", "fov": 85, "w": 1280, "h": 720, "post": true},
